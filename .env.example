// .env.example

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stay_northbengal

# Redis
REDIS_URL=redis://localhost:6379

# Razorpay (sandbox)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PAYOUT_ACCOUNT=1234567890
RAZORPAY_PAYOUT_ACCOUNT_NAME=Vendor Name
RAZORPAY_PAYOUT_IFSC=XXXX0000000

# Optional payout limits (in rupees)
PAYOUT_MIN_RUPEES=10
PAYOUT_MAX_RUPEES=10000

# AWS S3 (for KYC documents)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name
